<Container version="2">
  <!-- Delete this file if your repository does not ship Docker apps. -->
  <Name>free-games-claimer-remaster</Name>
  <Repository>ghcr.io/p-adamiec/free-games-claimer-remaster</Repository>
  <Registry>https://ghcr.io/p-adamiec/free-games-claimer-remaster</Registry>
  <Network>bridge</Network>

  <Shell>bash</Shell>
  <Privileged>false</Privileged>

  <!-- Optional but highly recommended: app icon -->
  <Icon>https://raw.githubusercontent.com/P-Adamiec/Free-Games-Claimer-Remaster/main/logo.png</Icon>
  
  <!-- NOTE: The port in the entry ALWAYS refers to the container port, not the host port-->
  <WebUI>http://[IP]:[PORT:7080]</WebUI>

  <!-- Plain text description -->
  <Overview>Automatically claims free games on Steam , Epic, Fab, Unity asset store, Amazon Prime Gaming, GOG, Ubisoft and AliExpress</Overview>

  <!-- NOTE: Either Support or Project is REQUIRED -->
  <!-- Project page -->
  <Project>https://github.com/P-Adamiec/Free-Games-Claimer-Remaster</Project>

  <!-- Raw URL to this exact template file -->
  <TemplateURL>https://raw.githubusercontent.com/Jaffa00/unraid-templates/main/templates/Free-Games-Claimer-Remaster.xml</TemplateURL>

  <!-- Readme first file -->
  <ReadMe>https://raw.githubusercontent.com/P-Adamiec/Free-Games-Claimer-Remaster/main/README.md</ReadMe>


  
  <!-- Valid category entries can be generated from the Application Categorizer plugin available in Apps -->
  <Category>Tools:</Category>

  <!-- Optional extra app search terms -->
  <ExtraSearchTerms>steam epic gog amazon</ExtraSearchTerms>

  <!-- Optional date (YYYY-MM-DD or YYYY-MM-DD HH:MM:SS) -->
  <Date>2026-09-14</Date>
  
  <!-- Optional: set to true if this is a beta container -->
   <Beta>true</Beta>

  <!-- Minimum and maximum Unraid version.-->
  <MinVer>6.1</MinVer>
  <MaxVer>7.3</MaxVer>

  <!-- Optionally set this if this container is deprecated for all OS versions -->
  <!-- <Deprecated>true</Deprecated> -->

  <!-- Optional: deprecate starting with a specific OS version -->
  <!-- <DeprecatedMaxVer>7.2</DeprecatedMaxVer> -->

  <!-- License of the container-->
  <License>AGPLv3</License>


  <!-- v2 templates should define ports/paths/variables with Config entries -->
  <Config Name="WebUI" Target="7080" Default="7080" Mode="tcp" Description="HTTP port for the NoVNC UI." Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/free-games-claimer-remaster" Mode="rw" Description="Persistent config files." Type="Path" Display="always" Required="true" Mask="false"/>
 
 <Config Name="FGC_TAG" target="FGC_TAG" default="latest" description="Docker image tag to run (set to dev to test experimental pre-release builds)." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="SHOW" target="SHOW" default="1" description="Show browser window (VNC)." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="WIDTH" target="WIDTH" default="1280" description="Browser/VNC screen width." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="HEIGHT" target="HEIGHT" default="720" description="Browser/VNC screen height." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOVNC_PORT" target="NOVNC_PORT" default="7080" description="noVNC web access port." type="variable" display="always" required="1" mask="0"/> 
<Config Name="VNC_IP" target="VNC_IP" default="localhost" description="Host for VNC notification links. Alerts include a one-click http://<VNC_IP>:<NOVNC_PORT>/?autoconnect=true." type="variable" display="always" required="1" mask="0"/> 
<Config Name="VNC_URL" target="VNC_URL" default="" description="Full public noVNC address for notification links, e.g. https://fgc.example.tld. Use it behind a reverse proxy: it keeps your scheme and drops the port, replacing VNC_IP and NOVNC_PORT in the link (NOVNC_PORT still publishes the container port)." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="VNC_PASSWORD" target="VNC_PASSWORD" default="" description="Optional password for VNC access (empty = no password)." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="SCHEDULER_HOURS" target="SCHEDULER_HOURS" default="12" description="Interval in hours between automatic claiming runs. Accepts any positive number (for example: 1, 12, 24, 72). Set 0 to disable interval runs." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="SCHEDULER_TIMEZONE" target="SCHEDULER_TIMEZONE" default="UTC" description="IANA timezone used for fixed daily scheduler times." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="SCHEDULER_FIXED_TIMES" target="SCHEDULER_FIXED_TIMES" default="" description="Optional comma-separated daily run times in 24-hour HH:MM format (17:00,21:30). Set SCHEDULER_HOURS=0 if you want only these fixed daily times without interval runs." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="RUN_ON_STARTUP" target="RUN_ON_STARTUP" default="true" description="Run once immediately when the container/application starts." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="VNC_LOGIN_TIMEOUT" target="VNC_LOGIN_TIMEOUT" default="180" description="Seconds the bot waits for you at any manual step: signing in, a code from e-mail or SMS, approving 2FA, a captcha, or Unity's checkout form. A window nobody answers ends that one store's manual steps for the rest of the run, and the summary says what it skipped. Raise it if you are not usually sitting at the computer." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="TIMEOUT" target="TIMEOUT" default="60" description="Advanced: seconds to wait for a page element before giving up." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="EMAIL" target="EMAIL" default="" description="Default login email used by ALL stores unless a store-specific *_EMAIL overrides it." type="variable" display="always" required="0" mask="0"/> 
<Config Name="PASSWORD" target="PASSWORD" default="" description="Default login password used by ALL stores unless a store-specific *_PASSWORD overrides it." type="variable" display="always" required="0" mask="0"/> 
<Config Name="EG_EMAIL" target="EG_EMAIL" default="" description="Epic Games login email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="EG_PASSWORD" target="EG_PASSWORD" default="" description="Epic Games login password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="EG_OTP_KEY" target="EG_OTP_KEY" default="" description="Epic Games authenticator (TOTP) key, auto-filled. Email/SMS codes are entered manually via VNC." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="EG_OTP_CODES" target="EG_OTP_CODES" default="" description="Comma-separated Epic recovery codes from the authenticator setup. Spent one at a time, used ones are written to data/used_epic_codes.txt." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="EG_PARENTALPIN" target="EG_PARENTALPIN" default="" description="Epic Games Parental Controls PIN." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="EG_MOBILE" target="EG_MOBILE" default="true" description="Also claim Epic's weekly free mobile game (claimed on the same store page as the PC games)." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="EG_MOBILE_PLATFORMS" target="EG_MOBILE_PLATFORMS" default="android,ios" description="Which mobile versions to claim, Android and iOS are separate items of the same game." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="PG_EMAIL" target="PG_EMAIL" default="" description="Prime Gaming (Amazon) email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="PG_PASSWORD" target="PG_PASSWORD" default="" description="Prime Gaming password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="PG_OTP_KEY" target="PG_OTP_KEY" default="" description="Prime Gaming authenticator (TOTP) key." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="PG_FORCE_CHECK_COLLECTED" target="PG_FORCE_CHECK_COLLECTED" default="0" description="Force re-check already marked 'claimed' games." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="PG_REDEEM" target="PG_REDEEM" default="0" description="Try to redeem keys automatically on external stores." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="GOG_EMAIL" target="GOG_EMAIL" default="" description="GOG login email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="GOG_PASSWORD" target="GOG_PASSWORD" default="" description="GOG login password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="GOG_NEWSLETTER" target="GOG_NEWSLETTER" default="0" description="Keep newsletter sub after claiming (1 = keep)." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="GOG_FORCE_REDEEM" target="GOG_FORCE_REDEEM" default="0" description="Force re-redeem old GOG codes from Prime Gaming." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="GOG_OTP_KEY" target="GOG_OTP_KEY" default="" description="GOG authenticator (TOTP) secret, auto-filled. Codes sent by e-mail are entered manually via VNC." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="GOG_OTP_CODES" target="GOG_OTP_CODES" default="" description="Comma-separated GOG recovery codes, tried after the secret. Used ones are written to data/used_gog_codes.txt." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="STEAM_USERNAME" target="STEAM_USERNAME" default="" description="Steam username." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="STEAM_PASSWORD" target="STEAM_PASSWORD" default="" description="Steam password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="FAB_ACCEPT_EULA" target="FAB_ACCEPT_EULA" default="true" description="Let the bot accept Fab's licence agreement and the EU right-of-withdrawal waiver, both required to claim. Set to false to stop before them. Fab reuses EG_EMAIL / EG_PASSWORD / EG_OTP_KEY." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="UNITY_EMAIL" target="UNITY_EMAIL" default="" description="Unity Asset Store login email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="UNITY_PASSWORD" target="UNITY_PASSWORD" default="" description="Unity Asset Store password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="UNITY_ACCEPT_TOS" target="UNITY_ACCEPT_TOS" default="true" description="Accept the Asset Store EULA and the 14-day withdrawal waiver at Unity's checkout. Set to false to stop before them and be notified instead." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="UBI_EMAIL" target="UBI_EMAIL" default="" description="Ubisoft Connect login email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="UBI_PASSWORD" target="UBI_PASSWORD" default="" description="Ubisoft Connect password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="UBI_OTP_KEY" target="UBI_OTP_KEY" default="" description="Ubisoft authenticator (TOTP) secret, for accounts with two-step verification." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="AE_EMAIL" target="AE_EMAIL" default="" description="AliExpress login email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="AE_PASSWORD" target="AE_PASSWORD" default="" description="AliExpress login password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="AE_MIN_COINS" target="AE_MIN_COINS" default="2" description="Skip the daily check-in when it offers fewer coins than this (protects against the 1-coin bot-flag state)." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="AE_FLAG_RETRIES" target="AE_FLAG_RETRIES" default="3" description="How many times to wait and re-approach the coin page when the offer is capped." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="AE_FLAG_WAIT" target="AE_FLAG_WAIT" default="480" description="Seconds to wait between retries (kept above AliExpress' ~7-min penalty so one wait clears it)." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="AE_PAGE_RETRIES" target="AE_PAGE_RETRIES" default="4" description="How many extra approaches to make when the coin page loads but renders nothing. AliExpress serves it empty most of the time (measured: one usable page in eight looks), so each retry is a real chance at the daily check-in. 0 gives up on the first look." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="STORES" target="STORES" default="(see note)" description="Comma-separated list of stores to run. Empty runs steam, epic, fab, prime, gog, ubisoft, aliexpress. Add unity, itchio, fanatical, indiegala or alienware to switch one on. GamerPower is asked once per run and its finds go to the store they belong to, so steam also claims the Steam giveaways it lists." type="variable" display="always" required="0" mask="0"/> 
<Config Name="RESET_DB_GAMES" target="RESET_DB_GAMES" default="false" description="Retroactively erase any database claims recorded within the last 7 days upon execution. Assists in clearing false positives." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="GP_CLAIM_DLC" target="GP_CLAIM_DLC" default="false" description="Also process GamerPower's in-game DLC giveaways. Off by default: most need an account in that specific game, and they are the bulk of the feed." type="variable" display="advanced" required="1" mask="0"/> 
<!--<Config Name="FANATICAL_ENABLE" target="FANATICAL_ENABLE" default="false" description="Replaced by STORES=...,fanatical. Still honoured for now." type="variable" display="advanced" required="1" mask="0"/> -->
<Config Name="FANATICAL_EMAIL" target="FANATICAL_EMAIL" default="" description="Fanatical account email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="FANATICAL_PASSWORD" target="FANATICAL_PASSWORD" default="" description="Fanatical account password." type="variable" display="advanced" required="0" mask="0"/> 
<!--<Config Name="ALIENWARE_ENABLE" target="ALIENWARE_ENABLE" default="false" description="Replaced by STORES=...,alienware. Still honoured for now." type="variable" display="advanced" required="1" mask="0"/> -->
<!--<Config Name="ITCHIO_ENABLE" target="ITCHIO_ENABLE" default="false" description="Replaced by STORES=...,itchio. Still honoured for now." type="variable" display="advanced" required="1" mask="0"/> -->
<Config Name="ITCHIO_EMAIL" target="ITCHIO_EMAIL" default="" description="Itch.io account email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="ITCHIO_PASSWORD" target="ITCHIO_PASSWORD" default="" description="Itch.io account password." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="ITCHIO_OTP_KEY" target="ITCHIO_OTP_KEY" default="" description="Itch.io authenticator (TOTP) secret, auto-filled." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="ITCHIO_OTP_CODES" target="ITCHIO_OTP_CODES" default="" description="Comma-separated Itch.io recovery codes, tried after the secret. Used ones are recorded in data/used_itchio_codes.txt so none is sent twice." type="variable" display="advanced" required="0" mask="0"/> 
<!--<Config Name="INDIEGALA_ENABLE" target="INDIEGALA_ENABLE" default="false" description="Replaced by STORES=...,indiegala. Still honoured for now." type="variable" display="advanced" required="1" mask="0"/> -->
<Config Name="INDIEGALA_EMAIL" target="INDIEGALA_EMAIL" default="" description="IndieGala account email." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="INDIEGALA_PASSWORD" target="INDIEGALA_PASSWORD" default="" description="IndieGala account password." type="variable" display="advanced" required="0" mask="0"/> 
<!--<Config Name="GP_UNKNOWN_STORES" target="GP_UNKNOWN_STORES" default="false" description="Reserved. Opening a site nobody mapped is not built yet, so this stays off whatever you set." type="variable" display="advanced" required="1" mask="0"/> -->
<Config Name="BROWSER_DIR" target="BROWSER_DIR" default="data/browser" description="Browser profile directory (persists cookies/sessions)." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="SCREENSHOTS_DIR" target="SCREENSHOTS_DIR" default="data/screenshots" description="Directory where debug/failure screenshots are saved." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="DEBUG" target="DEBUG" default="true" description="Shows verbose actions the bot takes." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="DEBUG_LIBS" target="DEBUG_LIBS" default="false" description="Adds the internals of the libraries the bot uses (every CDP frame sent to Chrome, HTTP handshakes, SQL queries). Only turn this on if a bug report asks for it." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="DRYRUN" target="DRYRUN" default="false" description="Simulate a run without claiming games. Detects available giveaways and sends a summary report." type="variable" display="always" required="1" mask="0"/> 
<Config Name="DISCORD_WEBHOOK" target="DISCORD_WEBHOOK" default="" description="Discord webhook URL for notifications." type="variable" display="advanced" required="0" mask="0"/> 
<Config Name="NOTIFY" target="NOTIFY" default="" description="Apprise URL(s) for Telegram, Slack, ntfy, etc. Multiple services can be separated by commas." type="variable" display="always" required="0" mask="0"/> 
<Config Name="NOTIFY_TEST" target="NOTIFY_TEST" default="false" description="Send a test notification on startup to verify your setup works." type="variable" display="always" required="1" mask="0"/> 
<Config Name="NOTIFY_SUMMARY" target="NOTIFY_SUMMARY" default="true" description="Set to false to disable game claim summaries. (Applies to all services)" type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_ERRORS" target="NOTIFY_ERRORS" default="true" description="Set to false to disable fatal error alerts. (Applies to all services)" type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_CLAIM_FAILS" target="NOTIFY_CLAIM_FAILS" default="false" description="Set to true to also report games that could not be claimed (e.g. a free DLC without the base game) in alerts and the run summary. (Applies to all services)" type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_ALREADY_CLAIMED" target="NOTIFY_ALREADY_CLAIMED" default="false" description="Set to true to also list games you already own and check-ins already collected today. By default the summary shows only what actually changed in that run." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_MISSING_BASE" target="NOTIFY_MISSING_BASE" default="true" description="Set to false to drop DLC entries that failed because you do not own the base game. They repeat every run and you can only fix them by buying the base game." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_DOWNLOAD_ONLY" target="NOTIFY_DOWNLOAD_ONLY" default="true" description="Set to false to drop Itch.io giveaways that are only a download, with nothing to claim onto your account. Reported once by default, then silent." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_UPDATES" target="NOTIFY_UPDATES" default="true" description="Check GitHub for a newer release (at startup, then at most once a day) and notify you once per version. Set to false to disable the check entirely, no request is made." type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_LOGIN_REQUEST" target="NOTIFY_LOGIN_REQUEST" default="true" description="Set to false to disable VNC login request pings. (Applies to all services)" type="variable" display="advanced" required="1" mask="0"/> 
<Config Name="NOTIFY_SKIP_STORES" target="NOTIFY_SKIP_STORES" default="" description="Comma-separated store keys whose notifications are silenced (they still run/claim). Accepts aliases (ae, amazon, gp). Example: aliexpress." type="variable" display="advanced" required="0" mask="0"/> 

