<Container version="2">
  <!-- Delete this file if your repository does not ship Docker apps. -->
  <Name>free-games-claimer-remaster</Name>
  <Repository>ghcr.io/p-adamiec/free-games-claimer-remaster</Repository>
  <Registry>https://ghcr.io/p-adamiec/free-games-claimer-remaster</Registry>
  <Network>bridge</Network>

  <Shell>bash</Shell>
  <Privileged>false</Privileged>

  <!-- Optional but highly recommended: app icon -->
  <Icon>https://raw.githubusercontent.com/P-Adamiec/Free-Games-Claimer-Remaster/main/logo.png</Icon>
  
  <!-- NOTE: The port in the entry ALWAYS refers to the container port, not the host port-->
  <WebUI>http://[IP]:[PORT:7080]</WebUI>

  <!-- Plain text description -->
  <Overview>Automatically claims free games on Steam , Epic, Fab, Unity asset store, Amazon Prime Gaming, GOG, Ubisoft and AliExpress</Overview>

  <!-- NOTE: Either Support or Project is REQUIRED -->
  <!-- Project page -->
  <Project>https://github.com/P-Adamiec/Free-Games-Claimer-Remaster</Project>

  <!-- Raw URL to this exact template file -->
  <TemplateURL>https://raw.githubusercontent.com/Jaffa00/unraid-templates/main/templates/Free-Games-Claimer-Remaster.xml</TemplateURL>

  <!-- Readme first file -->
  <ReadMe>https://raw.githubusercontent.com/P-Adamiec/Free-Games-Claimer-Remaster/main/README.md</ReadMe>


  
  <!-- Valid category entries can be generated from the Application Categorizer plugin available in Apps -->
  <Category>Tools:</Category>

  <!-- Optional extra app search terms -->
  <ExtraSearchTerms>steam epic gog amazon</ExtraSearchTerms>

  <!-- Optional date (YYYY-MM-DD or YYYY-MM-DD HH:MM:SS) -->
  <Date>2026-09-17</Date>
  
  <!-- Optional: set to true if this is a beta container -->
   <Beta>true</Beta>

  <!-- Minimum and maximum Unraid version.-->
  <MinVer>6.1</MinVer>
  <MaxVer>7.3.2</MaxVer>

  <!-- Optionally set this if this container is deprecated for all OS versions -->
  <!-- <Deprecated>true</Deprecated> -->

  <!-- Optional: deprecate starting with a specific OS version -->
  <!-- <DeprecatedMaxVer>7.2</DeprecatedMaxVer> -->

  <!-- License of the container-->
  <License>AGPLv3</License>


  <!-- v2 templates should define ports/paths/variables with Config entries -->
  <Config Name="WebUI" Target="7080" Default="7080" Mode="tcp" Description="HTTP port for the NoVNC UI." Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/free-games-claimer-remaster" Mode="rw" Description="Persistent config files." Type="Path" Display="always" Required="true" Mask="false"/>
 
 <Config Name="FGC_TAG" Target="FGC_TAG" Default="latest" Description="Docker image tag to run (set to dev to test experimental pre-release builds)." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="SHOW" Target="SHOW" Default="1" Description="Show browser window (VNC)." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="WIDTH" Target="WIDTH" Default="1280" Description="Browser/VNC screen width." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="HEIGHT" Target="HEIGHT" Default="720" Description="Browser/VNC screen height." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOVNC_PORT" Target="NOVNC_PORT" Default="7080" Description="noVNC web access port." Type="Variable" Display="always" Required="true" Mask="false"/> 
<Config Name="VNC_IP" Target="VNC_IP" Default="localhost" Description="Host for VNC notification links. Alerts include a one-click http://<VNC_IP>:<NOVNC_PORT>/?autoconnect=true." Type="Variable" Display="always" Required="true" Mask="false"/> 
<Config Name="VNC_URL" Target="VNC_URL" Default="" Description="Full public noVNC address for notification links, e.g. https://fgc.example.tld. Use it behind a reverse proxy: it keeps your scheme and drops the port, replacing VNC_IP and NOVNC_PORT in the link (NOVNC_PORT still publishes the container port)." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="VNC_PASSWORD" Target="VNC_PASSWORD" Default="" Description="Optional password for VNC access (empty = no password)." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="SCHEDULER_HOURS" Target="SCHEDULER_HOURS" Default="12" Description="Interval in hours between automatic claiming runs. Accepts any positive number (for example: 1, 12, 24, 72). Set 0 to disable interval runs." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="SCHEDULER_TIMEZONE" Target="SCHEDULER_TIMEZONE" Default="UTC" Description="IANA timezone used for fixed daily scheduler times." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="SCHEDULER_FIXED_TIMES" Target="SCHEDULER_FIXED_TIMES" Default="" Description="Optional comma-separated daily run times in 24-hour HH:MM format (17:00,21:30). Set SCHEDULER_HOURS=0 if you want only these fixed daily times without interval runs." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="RUN_ON_STARTUP" Target="RUN_ON_STARTUP" Default="true" Description="Run once immediately when the container/application starts." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="VNC_LOGIN_TIMEOUT" Target="VNC_LOGIN_TIMEOUT" Default="180" Description="Seconds the bot waits for you at any manual step: signing in, a code from e-mail or SMS, approving 2FA, a captcha, or Unity's checkout form. A window nobody answers ends that one store's manual steps for the rest of the run, and the summary says what it skipped. Raise it if you are not usually sitting at the computer." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="TIMEOUT" Target="TIMEOUT" Default="60" Description="Advanced: seconds to wait for a page element before giving up." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="EMAIL" Target="EMAIL" Default="" Description="Default login email used by ALL stores unless a store-specific *_EMAIL overrides it." Type="Variable" Display="always" Required="false" Mask="false"/> 
<Config Name="PASSWORD" Target="PASSWORD" Default="" Description="Default login password used by ALL stores unless a store-specific *_PASSWORD overrides it." Type="Variable" Display="always" Required="false" Mask="true"/> 
<Config Name="EG_EMAIL" Target="EG_EMAIL" Default="" Description="Epic Games login email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="EG_PASSWORD" Target="EG_PASSWORD" Default="" Description="Epic Games login password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="EG_OTP_KEY" Target="EG_OTP_KEY" Default="" Description="Epic Games authenticator (TOTP) key, auto-filled. Email/SMS codes are entered manually via VNC." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="EG_OTP_CODES" Target="EG_OTP_CODES" Default="" Description="Comma-separated Epic recovery codes from the authenticator setup. Spent one at a time, used ones are written to data/used_epic_codes.txt." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="EG_PARENTALPIN" Target="EG_PARENTALPIN" Default="" Description="Epic Games Parental Controls PIN." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="EG_MOBILE" Target="EG_MOBILE" Default="true" Description="Also claim Epic's weekly free mobile game (claimed on the same store page as the PC games)." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="EG_MOBILE_PLATFORMS" Target="EG_MOBILE_PLATFORMS" Default="android,ios" Description="Which mobile versions to claim, Android and iOS are separate items of the same game." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="PG_EMAIL" Target="PG_EMAIL" Default="" Description="Prime Gaming (Amazon) email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="PG_PASSWORD" Target="PG_PASSWORD" Default="" Description="Prime Gaming password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="PG_OTP_KEY" Target="PG_OTP_KEY" Default="" Description="Prime Gaming authenticator (TOTP) key." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="PG_FORCE_CHECK_COLLECTED" Target="PG_FORCE_CHECK_COLLECTED" Default="0" Description="Force re-check already marked 'claimed' games." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="PG_REDEEM" Target="PG_REDEEM" Default="0" Description="Try to redeem keys automatically on external stores." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="GOG_EMAIL" Target="GOG_EMAIL" Default="" Description="GOG login email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="GOG_PASSWORD" Target="GOG_PASSWORD" Default="" Description="GOG login password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="GOG_NEWSLETTER" Target="GOG_NEWSLETTER" Default="0" Description="Keep newsletter sub after claiming (1 = keep)." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="GOG_FORCE_REDEEM" Target="GOG_FORCE_REDEEM" Default="0" Description="Force re-redeem old GOG codes from Prime Gaming." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="GOG_OTP_KEY" Target="GOG_OTP_KEY" Default="" Description="GOG authenticator (TOTP) secret, auto-filled. Codes sent by e-mail are entered manually via VNC." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="GOG_OTP_CODES" Target="GOG_OTP_CODES" Default="" Description="Comma-separated GOG recovery codes, tried after the secret. Used ones are written to data/used_gog_codes.txt." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="STEAM_USERNAME" Target="STEAM_USERNAME" Default="" Description="Steam username." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="STEAM_PASSWORD" Target="STEAM_PASSWORD" Default="" Description="Steam password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="FAB_ACCEPT_EULA" Target="FAB_ACCEPT_EULA" Default="true" Description="Let the bot accept Fab's licence agreement and the EU right-of-withdrawal waiver, both required to claim. Set to false to stop before them. Fab reuses EG_EMAIL / EG_PASSWORD / EG_OTP_KEY." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="UNITY_EMAIL" Target="UNITY_EMAIL" Default="" Description="Unity Asset Store login email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="UNITY_PASSWORD" Target="UNITY_PASSWORD" Default="" Description="Unity Asset Store password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="UNITY_ACCEPT_TOS" Target="UNITY_ACCEPT_TOS" Default="true" Description="Accept the Asset Store EULA and the 14-day withdrawal waiver at Unity's checkout. Set to false to stop before them and be notified instead." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="UBI_EMAIL" Target="UBI_EMAIL" Default="" Description="Ubisoft Connect login email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="UBI_PASSWORD" Target="UBI_PASSWORD" Default="" Description="Ubisoft Connect password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="UBI_OTP_KEY" Target="UBI_OTP_KEY" Default="" Description="Ubisoft authenticator (TOTP) secret, for accounts with two-step verification." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="AE_EMAIL" Target="AE_EMAIL" Default="" Description="AliExpress login email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="AE_PASSWORD" Target="AE_PASSWORD" Default="" Description="AliExpress login password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="AE_MIN_COINS" Target="AE_MIN_COINS" Default="2" Description="Skip the daily check-in when it offers fewer coins than this (protects against the 1-coin bot-flag state)." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="AE_FLAG_RETRIES" Target="AE_FLAG_RETRIES" Default="3" Description="How many times to wait and re-approach the coin page when the offer is capped." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="AE_FLAG_WAIT" Target="AE_FLAG_WAIT" Default="480" Description="Seconds to wait between retries (kept above AliExpress' ~7-min penalty so one wait clears it)." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="AE_PAGE_RETRIES" Target="AE_PAGE_RETRIES" Default="4" Description="How many extra approaches to make when the coin page loads but renders nothing. AliExpress serves it empty most of the time (measured: one usable page in eight looks), so each retry is a real chance at the daily check-in. 0 gives up on the first look." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="STORES" Target="STORES" Default="(see note)" Description="Comma-separated list of stores to run. Empty runs steam, epic, fab, prime, gog, ubisoft, aliexpress. Add unity, itchio, fanatical, indiegala or alienware to switch one on. GamerPower is asked once per run and its finds go to the store they belong to, so steam also claims the Steam giveaways it lists." Type="Variable" Display="always" Required="false" Mask="false"/> 
<Config Name="RESET_DB_GAMES" Target="RESET_DB_GAMES" Default="false" Description="Retroactively erase any database claims recorded within the last 7 days upon execution. Assists in clearing false positives." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="GP_CLAIM_DLC" Target="GP_CLAIM_DLC" Default="false" Description="Also process GamerPower's in-game DLC giveaways. Off by default: most need an account in that specific game, and they are the bulk of the feed." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<!--<Config Name="FANATICAL_ENABLE" Target="FANATICAL_ENABLE" Default="false" Description="Replaced by STORES=...,fanatical. Still honoured for now." Type="Variable" Display="advanced" Required="true" Mask="false"/> -->
<Config Name="FANATICAL_EMAIL" Target="FANATICAL_EMAIL" Default="" Description="Fanatical account email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="FANATICAL_PASSWORD" Target="FANATICAL_PASSWORD" Default="" Description="Fanatical account password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<!--<Config Name="ALIENWARE_ENABLE" Target="ALIENWARE_ENABLE" Default="false" Description="Replaced by STORES=...,alienware. Still honoured for now." Type="Variable" Display="advanced" Required="true" Mask="false"/> -->
<!--<Config Name="ITCHIO_ENABLE" Target="ITCHIO_ENABLE" Default="false" Description="Replaced by STORES=...,itchio. Still honoured for now." Type="Variable" Display="advanced" Required="true" Mask="false"/> -->
<Config Name="ITCHIO_EMAIL" Target="ITCHIO_EMAIL" Default="" Description="Itch.io account email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="ITCHIO_PASSWORD" Target="ITCHIO_PASSWORD" Default="" Description="Itch.io account password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="ITCHIO_OTP_KEY" Target="ITCHIO_OTP_KEY" Default="" Description="Itch.io authenticator (TOTP) secret, auto-filled." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<Config Name="ITCHIO_OTP_CODES" Target="ITCHIO_OTP_CODES" Default="" Description="Comma-separated Itch.io recovery codes, tried after the secret. Used ones are recorded in data/used_itchio_codes.txt so none is sent twice." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<!--<Config Name="INDIEGALA_ENABLE" Target="INDIEGALA_ENABLE" Default="false" Description="Replaced by STORES=...,indiegala. Still honoured for now." Type="Variable" Display="advanced" Required="true" Mask="false"/> -->
<Config Name="INDIEGALA_EMAIL" Target="INDIEGALA_EMAIL" Default="" Description="IndieGala account email." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="INDIEGALA_PASSWORD" Target="INDIEGALA_PASSWORD" Default="" Description="IndieGala account password." Type="Variable" Display="advanced" Required="false" Mask="true"/> 
<!--<Config Name="GP_UNKNOWN_STORES" Target="GP_UNKNOWN_STORES" Default="false" Description="Reserved. Opening a site nobody mapped is not built yet, so this stays off whatever you set." Type="Variable" Display="advanced" Required="true" Mask="false"/> -->
<Config Name="BROWSER_DIR" Target="BROWSER_DIR" Default="data/browser" Description="Browser profile directory (persists cookies/sessions)." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="SCREENSHOTS_DIR" Target="SCREENSHOTS_DIR" Default="data/screenshots" Description="Directory where debug/failure screenshots are saved." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="DEBUG" Target="DEBUG" Default="true" Description="Shows verbose actions the bot takes." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="DEBUG_LIBS" Target="DEBUG_LIBS" Default="false" Description="Adds the internals of the libraries the bot uses (every CDP frame sent to Chrome, HTTP handshakes, SQL queries). Only turn this on if a bug report asks for it." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="DRYRUN" Target="DRYRUN" Default="false" Description="Simulate a run without claiming games. Detects available giveaways and sends a summary report." Type="Variable" Display="always" Required="true" Mask="false"/> 
<Config Name="DISCORD_WEBHOOK" Target="DISCORD_WEBHOOK" Default="" Description="Discord webhook URL for notifications." Type="Variable" Display="advanced" Required="false" Mask="false"/> 
<Config Name="NOTIFY" Target="NOTIFY" Default="" Description="Apprise URL(s) for Telegram, Slack, ntfy, etc. Multiple services can be separated by commas." Type="Variable" Display="always" Required="false" Mask="false"/> 
<Config Name="NOTIFY_TEST" Target="NOTIFY_TEST" Default="false" Description="Send a test notification on startup to verify your setup works." Type="Variable" Display="always" Required="true" Mask="false"/> 
<Config Name="NOTIFY_SUMMARY" Target="NOTIFY_SUMMARY" Default="true" Description="Set to false to disable game claim summaries. (Applies to all services)" Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_ERRORS" Target="NOTIFY_ERRORS" Default="true" Description="Set to false to disable fatal error alerts. (Applies to all services)" Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_CLAIM_FAILS" Target="NOTIFY_CLAIM_FAILS" Default="false" Description="Set to true to also report games that could not be claimed (e.g. a free DLC without the base game) in alerts and the run summary. (Applies to all services)" Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_ALREADY_CLAIMED" Target="NOTIFY_ALREADY_CLAIMED" Default="false" Description="Set to true to also list games you already own and check-ins already collected today. By default the summary shows only what actually changed in that run." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_MISSING_BASE" Target="NOTIFY_MISSING_BASE" Default="true" Description="Set to false to drop DLC entries that failed because you do not own the base game. They repeat every run and you can only fix them by buying the base game." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_DOWNLOAD_ONLY" Target="NOTIFY_DOWNLOAD_ONLY" Default="true" Description="Set to false to drop Itch.io giveaways that are only a download, with nothing to claim onto your account. Reported once by default, then silent." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_UPDATES" Target="NOTIFY_UPDATES" Default="true" Description="Check GitHub for a newer release (at startup, then at most once a day) and notify you once per version. Set to false to disable the check entirely, no request is made." Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_LOGIN_REQUEST" Target="NOTIFY_LOGIN_REQUEST" Default="true" Description="Set to false to disable VNC login request pings. (Applies to all services)" Type="Variable" Display="advanced" Required="true" Mask="false"/> 
<Config Name="NOTIFY_SKIP_STORES" Target="NOTIFY_SKIP_STORES" Default="" Description="Comma-separated store keys whose notifications are silenced (they still run/claim). Accepts aliases (ae, amazon, gp). Example: aliexpress." Type="Variable" Display="advanced" Required="false" Mask="false"/> 

  <!-- do these just work?
  <Config Name="PUID" Target="PUID" Default="99" Description="User ID to run the container as." Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="PGID" Target="PGID" Default="100" Description="Group ID to run the container as." Type="Variable" Display="advanced" Required="false" Mask="false"/>
-->

  <!--tags-->

</Container>

